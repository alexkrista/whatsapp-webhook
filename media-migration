"use strict";

const fs = require("fs");
const fsp = require("fs/promises");
const path = require("path");
const crypto = require("crypto");
const express = require("express");

let sharp = null;
try { sharp = require("sharp"); } catch {}

let photoUploadQueue = Promise.resolve();

function normalizePhone(value) {
  return String(value || "").replace(/\D/g, "");
}

function hmFromTimestampSeconds(value) {
  const n = Number(value || 0);
  if (!n) return "";
  return new Date(n * 1000).toLocaleTimeString("de-AT", {
    timeZone: "Europe/Vienna",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  });
}

function minuteFromHM(value) {
  const m = String(value || "").match(/^(\d{1,2}):(\d{2})$/);
  return m ? Number(m[1]) * 60 + Number(m[2]) : null;
}

async function readJson(file, fallback) {
  try {
    return JSON.parse(await fsp.readFile(file, "utf8"));
  } catch {
    return fallback;
  }
}

async function readJsonLines(file) {
  try {
    const text = await fsp.readFile(file, "utf8");
    return text.split("\n").filter(Boolean).map((line) => {
      try { return JSON.parse(line); } catch { return null; }
    }).filter(Boolean);
  } catch {
    return [];
  }
}

function resolveLegacyDayDir(dataDir, jobId, date) {
  const [year, month, day] = String(date).split("-");
  const modern = path.join(dataDir, jobId, year, month, day);
  if (fs.existsSync(modern)) return modern;
  const old = path.join(dataDir, jobId, date);
  return fs.existsSync(old) ? old : null;
}

function mediaKind(filename) {
  if (/\.(jpg|jpeg|png|webp)$/i.test(filename)) return "photo";
  if (/\.(mp4|mov|m4v|avi|webm)$/i.test(filename)) return "video";
  return "";
}

function viennaNow() {
  const parts = Object.fromEntries(new Intl.DateTimeFormat("en-CA", {
    timeZone: "Europe/Vienna",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  }).formatToParts(new Date()).map((part) => [part.type, part.value]));
  return { date: `${parts.year}-${parts.month}-${parts.day}`, at: `${parts.hour}:${parts.minute}` };
}

function decodedHeader(headers, name, fallback = "") {
  let value = String(headers?.[name] || fallback);
  try { value = decodeURIComponent(value); } catch {}
  return value.trim();
}

function safePhotoPart(value, fallback) {
  return (String(value || fallback)
    .replace(/[\x00-\x1f<>:"/\\|?*]+/g, "_")
    .replace(/\s+/g, " ")
    .trim() || fallback).slice(0, 120);
}

function photoFormat(filename, mimeType) {
  const ext = path.extname(String(filename || "")).toLowerCase();
  const mime = String(mimeType || "").toLowerCase().split(";", 1)[0].trim();
  if ([".jpg", ".jpeg"].includes(ext) || mime === "image/jpeg") return { ext: ".jpg", mime: "image/jpeg" };
  if (ext === ".png" || mime === "image/png") return { ext: ".png", mime: "image/png" };
  if (ext === ".webp" || mime === "image/webp") return { ext: ".webp", mime: "image/webp" };
  if ([".heic", ".heif"].includes(ext) || ["image/heic", "image/heif"].includes(mime)) return { ext: ".heic", mime: mime || "image/heic", convert: true };
  return null;
}

async function preparePhoto(raw, filename, mimeType) {
  const format = photoFormat(filename, mimeType);
  if (!format) throw new Error("Bitte ein Foto als JPG, PNG, WEBP oder HEIC verwenden.");
  if (!format.convert) return { data: raw, ext: format.ext, mime: format.mime };
  if (!sharp) throw new Error("HEIC-Fotos können auf diesem Server derzeit nicht umgewandelt werden.");
  try {
    const data = await sharp(raw).rotate().jpeg({ quality: 92, chromaSubsampling: "4:4:4" }).toBuffer();
    return { data, ext: ".jpg", mime: "image/jpeg" };
  } catch {
    throw new Error("Das HEIC-Foto konnte nicht gelesen werden. Bitte als JPG senden.");
  }
}

async function saveJobPhoto({ dataDir, jobId, raw, filename, mimeType, employeeId, employeeName, caption, source }) {
  const safeId = String(jobId || "").trim();
  if (!/^[A-Za-z0-9_-]+$/.test(safeId)) throw new Error("Ungültige Baustelle");
  if (!fs.existsSync(path.join(dataDir, safeId))) throw new Error("Baustelle nicht gefunden");
  if (!Buffer.isBuffer(raw) || !raw.length) throw new Error("Das Foto ist leer");
  if (raw.length > 30 * 1024 * 1024) throw new Error("Das Foto ist größer als 30 MB");

  const prepared = await preparePhoto(raw, filename, mimeType);
  const now = viennaNow();
  const uploaderId = safePhotoPart(employeeId, "office").replace(/[^A-Za-z0-9_-]+/g, "_").slice(0, 80) || "office";
  const dir = path.join(dataDir, "_kristine", "media", now.date, uploaderId);
  const stamp = Math.floor(Date.now() / 1000);
  const random = crypto.randomBytes(5).toString("hex");
  const originalBase = safePhotoPart(path.basename(String(filename || "Foto"), path.extname(String(filename || ""))), "Foto");
  const storedName = `${stamp}_${random}_${originalBase}${prepared.ext}`;
  const full = path.join(dir, storedName);
  await fsp.mkdir(dir, { recursive: true });
  await fsp.writeFile(full, prepared.data);

  const relative = path.relative(dataDir, full).split(path.sep).join("/");
  const meta = await readJson(path.join(dataDir, safeId, ".meta.json"), {});
  const entry = {
    id: `photo_followup_${stamp}_${random}`,
    createdAt: new Date().toISOString(),
    employeeId: String(employeeId || "").trim().slice(0, 120),
    employeeName: String(employeeName || "").trim().slice(0, 160),
    date: now.date,
    category: "photo",
    source: String(source || "Foto-Nachreichung").trim().slice(0, 120),
    file: relative,
    at: now.at,
    capturedAt: now.at,
    jobId: safeId,
    jobName: String(meta.name || safeId),
    bookingSegmentId: null,
    content: String(caption || "").trim().slice(0, 2000),
    originalName: safePhotoPart(filename, "Foto"),
    mimeType: prepared.mime,
    lateUpload: true,
  };

  const reviewFile = path.join(dataDir, "_kristine", "day-review-entries.json");
  const reviews = await readJson(reviewFile, []);
  reviews.push(entry);
  await fsp.mkdir(path.dirname(reviewFile), { recursive: true });
  const temp = `${reviewFile}.${process.pid}.${random}.tmp`;
  await fsp.writeFile(temp, JSON.stringify(reviews.slice(-50000), null, 2), "utf8");
  await fsp.rename(temp, reviewFile);

  return {
    ...entry,
    filename: storedName,
    kind: "photo",
    url: `/admin/api/job/${encodeURIComponent(safeId)}/media-file?file=${encodeURIComponent(relative)}`,
  };
}

function enqueueJobPhoto(input) {
  const next = photoUploadQueue.then(() => saveJobPhoto(input));
  photoUploadQueue = next.catch(() => {});
  return next;
}

function timestampFromFilename(filename) {
  const m = String(filename).match(/^(\d{10})(?:_|-)/);
  return m ? Number(m[1]) : 0;
}

function employeeForSender(employees, sender) {
  const wanted = normalizePhone(sender);
  if (!wanted) return null;
  return employees.find((employee) => {
    const phone = normalizePhone(employee.phone);
    return phone && (phone === wanted || phone.endsWith(wanted) || wanted.endsWith(phone));
  }) || null;
}

function activeTimeEvent(timeEvents, employeeId, date, at, fallbackJobId, fallbackJobName) {
  const wanted = minuteFromHM(at);
  const rows = timeEvents
    .filter((event) => String(event.employeeId) === String(employeeId) && String(event.date) === String(date))
    .map((event, index) => ({ ...event, _index: index, _minute: minuteFromHM(event.at) }))
    .filter((event) => event._minute !== null && (wanted === null || event._minute <= wanted))
    .sort((a, b) => a._minute - b._minute || a._index - b._index);
  const latest = [...rows].reverse().find((event) => ["start", "weiter"].includes(event.type) && event.jobId);
  return latest ? {
    jobId: String(latest.jobId),
    jobName: String(latest.jobName || latest.jobId),
    bookingSegmentId: latest.segmentId || null,
  } : {
    jobId: String(fallbackJobId || ""),
    jobName: String(fallbackJobName || fallbackJobId || ""),
    bookingSegmentId: null,
  };
}

async function migrateLegacyMediaForDate({ dataDir, date }) {
  const root = path.join(dataDir, "_kristine");
  const reviewFile = path.join(root, "day-review-entries.json");
  const employees = await readJson(path.join(dataDir, "_system", "employees.json"), []);
  const timeEvents = await readJson(path.join(root, "time-events.json"), []);
  const reviews = await readJson(reviewFile, []);
  const referenced = new Set(reviews.map((entry) => String(entry.file || "").replace(/\\/g, "/")).filter(Boolean));

  const jobIds = (await fsp.readdir(dataDir).catch(() => []))
    .filter((jobId) => jobId && !jobId.startsWith("_") && /^[A-Za-z0-9_-]+$/.test(jobId));

  let scanned = 0;
  let imported = 0;
  let unresolvedEmployees = 0;
  const added = [];

  for (const jobId of jobIds) {
    const dayDir = resolveLegacyDayDir(dataDir, jobId, date);
    if (!dayDir) continue;

    const meta = await readJson(path.join(dataDir, jobId, ".meta.json"), {});
    const jobName = String(meta.name || jobId);
    const logs = await readJsonLines(path.join(dayDir, "log.jsonl"));
    const files = (await fsp.readdir(dayDir).catch(() => [])).filter((name) => mediaKind(name));

    for (const filename of files) {
      scanned++;
      const full = path.join(dayDir, filename);
      const relative = path.relative(dataDir, full).split(path.sep).join("/");
      if (referenced.has(relative)) continue;

      const ts = timestampFromFilename(filename);
      const matchingLog = logs.find((entry) => {
        const rawTs = Number(entry?.raw?.timestamp || 0);
        const fileTs = timestampFromFilename(entry?.file || "");
        return (ts && rawTs === ts) || (ts && fileTs === ts) || String(entry?.file || "") === filename;
      }) || null;
      const sender = matchingLog?.from || matchingLog?.raw?.from || "";
      const employee = employeeForSender(employees, sender);
      if (!employee) unresolvedEmployees++;

      const at = hmFromTimestampSeconds(ts || matchingLog?.raw?.timestamp);
      const link = employee
        ? activeTimeEvent(timeEvents, employee.id, date, at, jobId, jobName)
        : { jobId, jobName, bookingSegmentId: null };

      const kind = mediaKind(filename);
      const entry = {
        id: `legacy_${date}_${jobId}_${filename}`.replace(/[^A-Za-z0-9_.-]+/g, "_").slice(0, 220),
        createdAt: new Date().toISOString(),
        migratedAt: new Date().toISOString(),
        migratedFromLegacy: true,
        employeeId: employee?.id || "",
        employeeName: employee?.name || "",
        date,
        category: kind,
        source: kind,
        file: relative,
        at,
        capturedAt: at,
        sender,
        jobId: link.jobId,
        jobName: link.jobName,
        bookingSegmentId: link.bookingSegmentId,
        content: matchingLog?.text || matchingLog?.raw?.image?.caption || matchingLog?.raw?.video?.caption || "",
      };
      reviews.push(entry);
      added.push(entry);
      referenced.add(relative);
      imported++;
    }
  }

  if (imported) {
    await fsp.mkdir(root, { recursive: true });
    await fsp.writeFile(reviewFile, JSON.stringify(reviews, null, 2), "utf8");
  }

  return { ok: true, date, scanned, imported, unresolvedEmployees, added };
}

async function listJobDayDirectories(dataDir, jobId) {
  const root = path.join(dataDir, jobId);
  if (!fs.existsSync(root)) return [];
  const out = [];
  const top = await fsp.readdir(root, { withFileTypes: true }).catch(() => []);

  for (const entry of top) {
    if (!entry.isDirectory()) continue;
    if (/^\d{4}-\d{2}-\d{2}$/.test(entry.name)) {
      out.push({ date: entry.name, dir: path.join(root, entry.name) });
      continue;
    }
    if (!/^\d{4}$/.test(entry.name)) continue;
    const year = entry.name;
    const months = await fsp.readdir(path.join(root, year), { withFileTypes: true }).catch(() => []);
    for (const monthEntry of months) {
      if (!monthEntry.isDirectory() || !/^\d{2}$/.test(monthEntry.name)) continue;
      const month = monthEntry.name;
      const days = await fsp.readdir(path.join(root, year, month), { withFileTypes: true }).catch(() => []);
      for (const dayEntry of days) {
        if (!dayEntry.isDirectory() || !/^\d{2}$/.test(dayEntry.name)) continue;
        out.push({ date: `${year}-${month}-${dayEntry.name}`, dir: path.join(root, year, month, dayEntry.name) });
      }
    }
  }

  return out.sort((a, b) => b.date.localeCompare(a.date));
}

async function listOriginalJobMedia({ dataDir, jobId }) {
  const safeId = String(jobId || "").trim();
  if (!/^[A-Za-z0-9_-]+$/.test(safeId)) return [];

  const reviews = await readJson(path.join(dataDir, "_kristine", "day-review-entries.json"), []);
  const reviewByFile = new Map();
  for (const entry of reviews) {
    const file = String(entry?.file || "").replace(/\\/g, "/");
    if (file) reviewByFile.set(file, entry);
  }

  const items = [];
  const listedFiles = new Set();
  const dayDirs = await listJobDayDirectories(dataDir, safeId);
  for (const row of dayDirs) {
    const logs = await readJsonLines(path.join(row.dir, "log.jsonl"));
    const files = (await fsp.readdir(row.dir).catch(() => [])).filter((name) => mediaKind(name));
    for (const filename of files) {
      const full = path.join(row.dir, filename);
      const relative = path.relative(dataDir, full).split(path.sep).join("/");
      const review = reviewByFile.get(relative) || null;
      const ts = timestampFromFilename(filename);
      const matchingLog = logs.find((entry) => {
        const rawTs = Number(entry?.raw?.timestamp || 0);
        const fileTs = timestampFromFilename(entry?.file || "");
        return (ts && rawTs === ts) || (ts && fileTs === ts) || String(entry?.file || "") === filename;
      }) || null;
      const at = review?.at || review?.capturedAt || hmFromTimestampSeconds(ts || matchingLog?.raw?.timestamp);
      const content = String(review?.content || matchingLog?.text || matchingLog?.raw?.image?.caption || matchingLog?.raw?.video?.caption || "").trim();
      items.push({
        id: review?.id || `${row.date}_${filename}`,
        jobId: safeId,
        date: row.date,
        at,
        kind: mediaKind(filename),
        filename,
        file: relative,
        employeeId: review?.employeeId || "",
        employeeName: review?.employeeName || "",
        content,
        source: review?.source || "Baustellenprotokoll",
        url: `/admin/api/job/${encodeURIComponent(safeId)}/media-file?file=${encodeURIComponent(relative)}`,
      });
      listedFiles.add(relative);
    }
  }

  // KGO-Medien liegen zentral unter _kristine/media und werden ueber den
  // Eintrag in day-review-entries.json einer Baustelle zugeordnet. Sie sind
  // deshalb nicht in den Tagesordnern der Baustelle zu finden.
  for (const review of reviews) {
    if (String(review?.jobId || "").trim() !== safeId) continue;
    const relative = String(review?.file || "").replace(/\\/g, "/");
    const kind = mediaKind(path.basename(relative));
    if (!relative || !kind || listedFiles.has(relative)) continue;

    const full = path.resolve(dataDir, relative);
    const mediaRoot = path.resolve(dataDir, "_kristine", "media") + path.sep;
    if (!full.startsWith(mediaRoot) || !fs.existsSync(full)) continue;

    const filename = path.basename(relative);
    const timestamp = timestampFromFilename(filename);
    items.push({
      id: review.id || `${review.date || "media"}_${filename}`,
      jobId: safeId,
      date: String(review.date || ""),
      at: review.at || review.capturedAt || hmFromTimestampSeconds(timestamp),
      kind,
      filename,
      file: relative,
      employeeId: review.employeeId || "",
      employeeName: review.employeeName || "",
      content: String(review.content || "").trim(),
      source: review.source || "KGO",
      url: `/admin/api/job/${encodeURIComponent(safeId)}/media-file?file=${encodeURIComponent(relative)}`,
    });
    listedFiles.add(relative);
  }

  return items.sort((a, b) => b.date.localeCompare(a.date) || String(b.at || "").localeCompare(String(a.at || "")) || a.filename.localeCompare(b.filename, "de"));
}

async function listJobMedia({ dataDir, jobId }) {
  const assignments = await readJson(path.join(dataDir, "_kristine", "media-assignments.json"), {});
  const items = (await listOriginalJobMedia({ dataDir, jobId })).filter(item => !assignments[item.file] || assignments[item.file].jobId === jobId);
  const sources = new Set(Object.values(assignments).filter(row => row.jobId === jobId && row.originalJobId !== jobId).map(row => row.originalJobId));
  for (const originalJobId of sources) for (const item of await listOriginalJobMedia({ dataDir, jobId: originalJobId })) {
    if (assignments[item.file]?.jobId === jobId && !items.some(row => row.file === item.file)) items.push({ ...item, jobId, url: `/admin/api/job/${encodeURIComponent(jobId)}/media-file?file=${encodeURIComponent(item.file)}` });
  }
  return items.sort((a,b) => b.date.localeCompare(a.date) || String(b.at || "").localeCompare(String(a.at || "")));
}

let mediaAssignmentQueue = Promise.resolve();
async function reassignJobMedia({ dataDir, jobId, targetJobId, files }) {
  const run = mediaAssignmentQueue.then(async () => {
    if (![jobId,targetJobId].every(id => /^[A-Za-z0-9_-]+$/.test(String(id || ""))) || jobId === targetJobId) throw Error("Bitte eine andere gültige Baustelle wählen.");
    if (!(await fsp.stat(path.join(dataDir,targetJobId)).catch(()=>null))?.isDirectory()) throw Error("Zielbaustelle nicht gefunden.");
    if (!Array.isArray(files) || !files.length || files.length > 100) throw Error("Bitte 1 bis 100 Fotos oder Videos auswählen.");
    const selected = [...new Set(files)], available = await listJobMedia({dataDir,jobId});
    if (selected.some(file => !available.some(item => item.file === file))) throw Error("Die Foto-Zuordnung hat sich geändert. Bitte neu laden.");
    const file = path.join(dataDir,"_kristine","media-assignments.json"), assignments = await readJson(file,{}), at = new Date().toISOString();
    for (const key of selected) { const previous = assignments[key]; assignments[key] = { originalJobId: previous?.originalJobId || jobId, jobId: targetJobId, updatedAt: at, history: [...(previous?.history || []), { from: jobId, to: targetJobId, at }] }; }
    await fsp.mkdir(path.dirname(file),{recursive:true});await fsp.writeFile(file+".tmp",JSON.stringify(assignments,null,2));await fsp.rename(file+".tmp",file);
    return { count:selected.length, jobId:targetJobId };
  });
  mediaAssignmentQueue=run.catch(()=>{});return run;
}

async function listJobKnowledge({ dataDir, jobId }) {
  const safeId = String(jobId || "").trim();
  if (!/^[A-Za-z0-9_-]+$/.test(safeId)) return null;
  const root = path.join(dataDir, "_kristine");
  const belongsToJob = (row) => String(row?.jobId || "").trim() === safeId;
  const [reviews, materialRequests, tasks, assignments, timeEvents, events, workflows, appointments] = await Promise.all([
    readJson(path.join(root, "day-review-entries.json"), []),
    readJson(path.join(root, "material-requests.json"), []),
    readJson(path.join(root, "tasks.json"), []),
    readJson(path.join(root, "assignments.json"), []),
    readJson(path.join(root, "time-events.json"), []),
    readJsonLines(path.join(root, "events.jsonl")),
    readJson(path.join(root, "visit-workflows.json"), []),
    readJson(path.join(root, "appointments.json"), []),
  ]);

  const media = await listJobMedia({ dataDir, jobId: safeId });
  const mediaByFile = new Map(media.map((item) => [String(item.file || "").replace(/\\/g, "/"), item]));
  const linkedReviews = reviews.filter(belongsToJob).map((entry) => {
    const relative = String(entry?.file || "").replace(/\\/g, "/");
    const linkedMedia = mediaByFile.get(relative);
    return {
      ...entry,
      file: relative,
      kind: linkedMedia?.kind || mediaKind(path.basename(relative)) || String(entry?.category || entry?.source || "entry"),
      url: linkedMedia?.url || "",
    };
  });

  const linkedTasks = tasks.filter(belongsToJob);
  const linkedTaskIds = new Set(linkedTasks.map((row) => String(row?.id || "")).filter(Boolean));
  const linkedWorkflows = workflows.filter((row) =>
    belongsToJob(row) || linkedTaskIds.has(String(row?.taskId || ""))
  );
  const linkedAppointments = appointments.filter((row) => linkedTaskIds.has(String(row?.taskId || "")));
  const attachments = [];
  for (const taskId of linkedTaskIds) {
    const dir = path.join(root, "visit-files", taskId);
    const names = (await fsp.readdir(dir).catch(() => [])).filter((name) => name.endsWith(".json"));
    for (const name of names) {
      const entry = await readJson(path.join(dir, name), null);
      if (entry?.id) attachments.push({
        ...entry,
        taskId,
        url: `/kristine/api/tasks/${encodeURIComponent(taskId)}/visit-file/${encodeURIComponent(entry.id)}`,
      });
    }
  }
  const protocolEntries = [];
  for (const day of await listJobDayDirectories(dataDir, safeId)) {
    const logs = await readJsonLines(path.join(day.dir, "log.jsonl"));
    for (const row of logs) {
      const text = String(
        row?.transcript || row?.text || row?.raw?.image?.caption || row?.raw?.video?.caption || ""
      ).trim();
      if (!text && !["pdf", "audio_saved", "transcription_failed"].includes(String(row?.type || ""))) continue;
      protocolEntries.push({
        date: day.date,
        at: row?.at || "",
        type: String(row?.type || "entry"),
        text,
        file: String(row?.file || ""),
        sender: String(row?.from || ""),
        error: String(row?.error || ""),
      });
    }
  }

  return {
    ok: true,
    jobId: safeId,
    counts: {
      media: media.length,
      reviews: linkedReviews.length,
      materialRequests: materialRequests.filter(belongsToJob).length,
      messages: events.filter((row) => belongsToJob(row) && String(row?.type || "") === "employee_message").length,
      tasks: tasks.filter(belongsToJob).length,
      assignments: assignments.filter(belongsToJob).length,
      timeEvents: timeEvents.filter(belongsToJob).length,
      appointments: linkedAppointments.length,
      workflows: linkedWorkflows.length,
      attachments: attachments.length,
      protocolEntries: protocolEntries.length,
    },
    media,
    reviews: linkedReviews,
    materialRequests: materialRequests.filter(belongsToJob),
    events: events.filter(belongsToJob),
    tasks: linkedTasks,
    assignments: assignments.filter(belongsToJob),
    timeEvents: timeEvents.filter(belongsToJob),
    appointments: linkedAppointments,
    workflows: linkedWorkflows,
    attachments,
    protocolEntries,
  };
}

function registerMediaMigration(app, { dataDir, requireAdmin }) {
  app.post("/admin/api/job/:jobId/media/reassign", async (req,res) => {
    if (!requireAdmin(req,res)) return;
    try { res.json({ok:true,...await reassignJobMedia({dataDir,jobId:req.params.jobId,targetJobId:req.body?.targetJobId,files:req.body?.files})}); }
    catch(error) { res.status(400).json({ok:false,error:String(error.message || error)}); }
  });
  app.post("/admin/api/media-migration/:date", async (req, res) => {
    if (!requireAdmin(req, res)) return;
    try {
      const date = String(req.params.date || "").slice(0, 10);
      if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
        return res.status(400).json({ ok: false, error: "Ungültiges Datum" });
      }
      const result = await migrateLegacyMediaForDate({ dataDir, date });
      res.json(result);
    } catch (error) {
      console.error("Legacy media migration failed:", error);
      res.status(500).json({ ok: false, error: String(error?.message || error) });
    }
  });

  app.get("/admin/api/job/:jobId/media", async (req, res) => {
    if (!requireAdmin(req, res)) return;
    try {
      const jobId = String(req.params.jobId || "").trim();
      if (!/^[A-Za-z0-9_-]+$/.test(jobId)) return res.status(400).json({ ok: false, error: "Ungültige Baustelle" });
      const media = await listJobMedia({ dataDir, jobId });
      res.json({ ok: true, jobId, count: media.length, media });
    } catch (error) {
      console.error("Baustellen media list failed:", error);
      res.status(500).json({ ok: false, error: String(error?.message || error) });
    }
  });

  app.post("/admin/api/job/:jobId/media", express.raw({
    type: ["image/*", "application/octet-stream"],
    limit: "30mb",
  }), async (req, res) => {
    if (!requireAdmin(req, res)) return;
    try {
      const jobId = String(req.params.jobId || "").trim();
      const raw = Buffer.isBuffer(req.body) ? req.body : Buffer.from(req.body || "");
      const item = await enqueueJobPhoto({
        dataDir,
        jobId,
        raw,
        filename: decodedHeader(req.headers, "x-file-name", "Foto.jpg"),
        mimeType: String(req.headers["content-type"] || "application/octet-stream"),
        employeeId: decodedHeader(req.headers, "x-employee-id"),
        employeeName: decodedHeader(req.headers, "x-employee-name"),
        caption: decodedHeader(req.headers, "x-photo-caption"),
        source: decodedHeader(req.headers, "x-photo-source", "Foto-Nachreichung"),
      });
      res.status(201).json({ ok: true, jobId, item });
    } catch (error) {
      console.error("Baustellen photo follow-up failed:", error);
      const message = String(error?.message || error);
      const status = /nicht gefunden/i.test(message) ? 404 : /Ungültig|Bitte|leer|größer|HEIC/i.test(message) ? 400 : 500;
      res.status(status).json({ ok: false, error: message });
    }
  });

  app.get("/admin/api/job/:jobId/knowledge", async (req, res) => {
    if (!requireAdmin(req, res)) return;
    try {
      const knowledge = await listJobKnowledge({ dataDir, jobId: req.params.jobId });
      if (!knowledge) return res.status(400).json({ ok: false, error: "Ungültige Baustelle" });
      res.json(knowledge);
    } catch (error) {
      console.error("Baustellen knowledge list failed:", error);
      res.status(500).json({ ok: false, error: String(error?.message || error) });
    }
  });

  app.get("/admin/api/job/:jobId/media-file", async (req, res) => {
    if (!requireAdmin(req, res)) return;
    try {
      const jobId = String(req.params.jobId || "").trim();
      const relative = String(req.query.file || "").replace(/\\/g, "/");
      if (!/^[A-Za-z0-9_-]+$/.test(jobId) || !relative || relative.includes("..")) {
        return res.status(400).send("Ungültige Mediendatei");
      }
      const full = path.resolve(dataDir, relative);
      const jobRoot = path.resolve(dataDir, jobId) + path.sep;
      const kgoRoot = path.resolve(dataDir, "_kristine", "media") + path.sep;
      const inJobFolder = full.startsWith(jobRoot);
      const assignments = await readJson(path.join(dataDir,"_kristine","media-assignments.json"),{});
      const assignment = assignments[relative];
      const reassignedMedia = assignment?.jobId === jobId && (full.startsWith(path.resolve(dataDir,assignment.originalJobId)+path.sep) || full.startsWith(kgoRoot));
      let assignedKgoMedia = false;
      if (full.startsWith(kgoRoot)) {
        const reviews = await readJson(path.join(dataDir, "_kristine", "day-review-entries.json"), []);
        assignedKgoMedia = reviews.some((entry) =>
          String(entry?.jobId || "").trim() === jobId &&
          String(entry?.file || "").replace(/\\/g, "/") === relative
        );
      }
      if ((assignment && assignment.jobId !== jobId) || (!inJobFolder && !assignedKgoMedia && !reassignedMedia) || !mediaKind(path.basename(full)) || !fs.existsSync(full)) {
        return res.status(404).send("Datei nicht gefunden");
      }
      res.setHeader("Cache-Control", "private, max-age=3600");
      return res.sendFile(full);
    } catch (error) {
      console.error("Baustellen media file failed:", error);
      res.status(500).send(String(error?.message || error));
    }
  });
}

module.exports = { migrateLegacyMediaForDate, registerMediaMigration, listJobMedia, listJobKnowledge, saveJobPhoto, reassignJobMedia };
